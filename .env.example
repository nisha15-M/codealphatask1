# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/campuscart

# JWT secret (use a long random string in production)
JWT_SECRET=replace_this_with_a_long_random_secret

# Server port
PORT=5000

# Comma-separated list of allowed college email domains
# Example: @college.edu,@university.ac.in
ALLOWED_COLLEGE_DOMAINS=@college.edu
